<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Band simulator control, debug builds only. DUMP is held by the adb
             shell and cannot be granted to an installed app, so nothing else
             on the device can switch the app into simulation mode. -->
        <receiver
            android:name=".debug.SimBandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.bipss.app.debug.SIM_MODE" />
                <action android:name="com.bipss.app.debug.SIM_START" />
                <action android:name="com.bipss.app.debug.SIM_STOP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
