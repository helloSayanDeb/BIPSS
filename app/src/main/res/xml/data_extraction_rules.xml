<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: allowBackup="false" stops cloud backup but not device-to-device
  transfer, which would still copy the raw health database to a new phone.
  Everything is excluded from both. The user's own Drive backup (Settings)
  is the only way data leaves this phone for another one.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
