<?xml version="1.0" encoding="utf-8"?>
<!--
  BIPSS 4 launcher icon foreground — a hand-built vector heartbeat/pulse
  trace, white on the brand-blue background. Kept inside the 66dp adaptive-
  icon safe zone (centered in the 108x108 viewport) so it survives circle,
  squircle, and rounded-square launcher masks. No emoji, no downloaded
  artwork — plain vector path data.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M21,58 L37,58 L46,36 L58,80 L68,46 L74,58 L87,58"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M87,58 m-4,0 a4,4 0,1 1,8 0 a4,4 0,1 1,-8 0"
        android:fillColor="#FFFFFFFF" />
</vector>
