<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Bluetooth (API 31+ split permissions). The phone is only ever a BLE
      central: it scans for and connects to the band, and never advertises or
      hosts a GATT server, so BLUETOOTH_ADVERTISE is deliberately absent.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!--
      Android 8-11 (minSdk 26) predate the split permissions above: scanning and
      connecting there need the legacy pair, without which startScan() and
      connectGatt() throw SecurityException.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!--
      Location: local weather/air quality/alerts and the SOS position. Either
      grant is accepted (a user may choose "approximate"); on API < 31 BLE
      scanning also requires it.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Notifications (Android 13+ runtime permission) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Foreground service for the band connection. Without this the GATT link is
      dropped when the app backgrounds, which is exactly what happens overnight
      and would mean no sleep data at all.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Indoor/outdoor GNSS checks while the band is connected (spec 5.9). The
         type is only requested at runtime with precise location granted and
         the app in the foreground; see BleForegroundService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- SOS SMS -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Emergency contact picker (reads the device's own Contacts app) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
      Health Connect - only what is used: the profile's height and weight are
      written there. Nothing is read from it, and wearable readings (heart rate,
      SpO2) are deliberately never written: they stay in this app's own Room
      database, since Health Connect is an OS-level store any granted app can read.
    -->
    <uses-permission android:name="android.permission.health.WRITE_HEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- SEND_SMS would otherwise imply telephony and hide the app from tablets/Chromebooks. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".BipssApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.BIPSS"
        tools:targetApi="31">


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.BIPSS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home-screen water log. Its buttons are explicit broadcasts to this receiver only. -->
        <receiver
            android:name=".widget.WaterWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/water_widget_info" />
        </receiver>

        <!-- Hands exported reports and CSV bundles to the share sheet; nothing else is exposed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".ble.BleForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <!--
          Health Connect permission rationale. Android 14+ looks for
          VIEW_PERMISSION_USAGE with the HEALTH_PERMISSIONS category on an alias
          guarded by START_VIEW_PERMISSION_USAGE; Android 13 and below look for
          the androidx action. Without a match the permission request fails silently.
        -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="HealthConnectRationaleActivity"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>

        <!-- WorkManager initializer -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
